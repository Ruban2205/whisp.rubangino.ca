{
  "name": "whisp",
  "version": "1.0.0",
  "description": "A private little space to write, breathe, and let go. By Ruban AI Labs.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:voice": "node scripts/prepare-voice.mjs",
    "predev": "npm run prepare:voice",
    "prebuild": "npm run prepare:voice"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruban2205/whisp.rubangino.ca.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Ruban2205/whisp.rubangino.ca/issues"
  },
  "homepage": "https://github.com/Ruban2205/whisp.rubangino.ca#readme",
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@huggingface/transformers": "3.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "^0.35.5"
    }
  }
}
