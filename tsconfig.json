{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "*.ts"]
}
